# Configuração independente por função. Credenciais ficam somente no servidor.
# Provedores: none, openai, openai-compatible, anthropic, google, ollama.
AI_MODE=model
AI_PROVIDER=none
AI_MODEL=
# AI_BASE_URL=http://127.0.0.1:11434
# AI_API_KEY_ENV=MINHA_CHAVE_DE_DIAGNOSTICO
# Apenas para openai-compatible: json_schema, json_object ou prompt.
AI_RESPONSE_FORMAT=json_schema
# AI_TIMEOUT_MS=30000

# Embeddings podem usar outro provedor e podem permanecer desativados.
# Adaptadores: none, openai, openai-compatible, google, ollama.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
# EMBEDDING_BASE_URL=http://127.0.0.1:11434
# EMBEDDING_API_KEY_ENV=MINHA_CHAVE_DE_EMBEDDINGS
# Omita para usar a dimensão nativa do modelo.
# EMBEDDING_DIMENSIONS=768
# Altere se a versão do modelo mudar mantendo o mesmo identificador.
# EMBEDDING_REVISION=v1

# Aliases de credenciais reconhecidos pelos adaptadores, conforme o provedor:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
DATABASE_URL=postgresql://sentinela:sentinela_local@127.0.0.1:56471/sentinela
MONITOR_INTERVAL_MS=4000
LAB_ENABLED=true
LAB_BASE_PORT=4421
# Apenas para ambiente externo explicitamente configurado.
# PROMETHEUS_URL=http://127.0.0.1:9090
# MONITORED_SERVICES=checkout,payments,inventory
# MONITORED_ENVIRONMENT=staging  # Na integração, usa SDLC_ENVIRONMENT por padrão.
# ALERT_WEBHOOK_TOKEN=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Ingestão normalizada de logs, traces e alterações externas.
# TELEMETRY_INGEST_TOKEN=
# APP_ORIGINS=http://127.0.0.1:4320,http://localhost:4320

# Cliente opcional de registro de deploy (npm run report:deployment).
# SENTINELA_URL=http://127.0.0.1:4320
# SENTINELA_INGEST_TOKEN=  # Mesmo valor de TELEMETRY_INGEST_TOKEN no servidor.
# SERVICE_NAME=catalog-api
# SOURCE_REPOSITORY=lucasnscr/issue-to-pr-ai
# SOURCE_COMMIT=  # SHA do commit implantado; não use o SHA do Sentinela.
# DEPLOYMENT_ENVIRONMENT=local

# Monitoramento e ajustes de Kubernetes / Azure Functions.
OPERATIONS_ENABLED=false
OPERATIONS_EXECUTION_ENABLED=false
# OPERATIONS_CONFIG_FILE=./operations.local.json
# OPERATIONS_API_TOKEN=  # Segredo separado, com pelo menos 24 caracteres.
OPERATIONS_INTERVAL_MS=15000
OPERATIONS_COOLDOWN_MS=300000
# ORDERS_HEALTHCHECK_KEY=  # Valor da variável referenciada em healthKeyEnv.

# Ponte de incidentes para issues e verificação de entregas.
SDLC_ENABLED=false
# SDLC_REPOSITORY=lucasnscr/issue-to-pr-ai
# SDLC_ENVIRONMENT=staging
# SDLC_SERVICES=catalog-api
# SDLC_GITHUB_TOKEN_ENV=SENTINELA_GITHUB_TOKEN
# SENTINELA_GITHUB_TOKEN=  # Somente worker; issues:write no destino configurado.
# SDLC_CALLBACK_TOKEN=  # Mesmo valor de SENTINELA_CALLBACK_TOKEN no pipeline.
SDLC_VERIFY_TIMEOUT_MS=300000
SDLC_MAX_ATTEMPTS=3

# Timeouts de reconciliação; não autorizam outra mutação
SDLC_INACTIVITY_TIMEOUT_MS=604800000
SDLC_DEPLOYMENT_TIMEOUT_MS=1200000
